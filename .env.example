# Copy to .env and fill in the blank values. Never commit .env.

# App
APP_ENV=local
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
SENTRY_DSN=

# Postgres (Compose builds DATABASE_URL from these for the api and worker)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional: host port for Postgres when 5432 is already taken (default 5432)
POSTGRES_HOST_PORT=

# Redis
REDIS_URL=

# Auth
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_SEC=60

# OTP
OTP_PROVIDER=mock
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FIREBASE_PROJECT_ID=

# Realtime and limits
SSE_HEARTBEAT_SEC=15
SSE_MAX_CONN_PER_USER=
SSE_MAX_CONN_PER_IP=
SSE_MAX_CONN_PER_INSTANCE=
ETA_CACHE_TTL_SEC=
IDEMPOTENCY_TTL_SEC=86400

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
